menu "espforge"

    config FORGE_HTTPS_PORT
        int "Settings page HTTPS port"
        default 443
        range 1 65535
        help
            The settings page's port on the home network. 443 normally. A board whose Wi-Fi is a co-processor running
            esp-hosted with "network split" (an ESP32-P4 with an ESP32-C6) hands the host only some ports: 49152-61439
            and a static list that an older co-processor firmware may not give 443 (the Guition JC1060P470C: the page
            was unreachable). Every address the firmware writes (QR codes, redirects, the log) carries the port when it
            is not 443; the PC tools read forge.json's https_port.

    config FORGE_SETUP_SSID
        string "Setup network name"
        default "Forge-Setup"
        help
            Name of the access point the device opens for Wi-Fi setup (captive portal). Same as setup_ssid in
            forge.json (tools/harness joins it from the PC).

    config FORGE_TLS_NAME
        string "Name in the HTTPS certificate"
        default "espforge device"
        help
            Common name of the per-device self-signed certificate, followed by the last 3 bytes of the MAC.

    config FORGE_REPO
        string "GitHub repository (owner/name)"
        default "TheMonkeyz/espforge"
        help
            Used in the User-Agent of the firmware's own HTTP requests.

    config FORGE_PRODUCT
        string "Product name (User-Agent, certificate)"
        default ""
        help
            The name in the User-Agent of the firmware's own requests ("<product>/<version> (...)") and in the
            certificate's organisation (O=). Empty: the ESP-IDF project name.

    config FORGE_UA_COMMENT
        string "User-Agent comment"
        default ""
        help
            Optional words before the repository link: "<product>/<version> (<comment>; +https://github.com/...)".
            Public APIs (OpenStreetMap's tile policy) ask apps to say what they are.

    config FORGE_PORTAL_NAME
        string "Name in the captive portal's link"
        default ""
        help
            The setup network's sign-in page links to the settings page as "<name> setup". Empty: the ESP-IDF
            project name.

endmenu
